# git-builder configuration. Edit these; everything else reads from here.

# Where finished projects get built. Each night creates a new subdirectory.
BUILD_ROOT="$HOME/Documents/GitHub/git-builder/builds"

# Repo visibility for the nightly push: public | private
# public is the point if you want the contribution graph to show it.
REPO_VISIBILITY="public"

# Set to 1 to build and commit locally but NOT create/push a GitHub repo.
# Useful for a dry run on night one.
NO_PUSH="0"

# Model for the scout + build phases. opus is the strongest; sonnet is cheaper.
SCOUT_MODEL="sonnet"
BUILD_MODEL="opus"

# Hard spend ceiling per phase, in USD. The run aborts rather than exceeding it.
SCOUT_BUDGET_USD="1.00"
BUILD_BUDGET_USD="8.00"

# Wall-clock timeout per phase, in seconds.
SCOUT_TIMEOUT="600"
BUILD_TIMEOUT="3600"

# macOS notification when the morning report is ready.
NOTIFY="1"

# Prefix for generated repo names, e.g. "nightly-" -> nightly-whisper-diff
# Leave empty for no prefix.
REPO_PREFIX=""
